{
  "name": "@centurio1987/bbangto-ui-foundations",
  "version": "1.1.0",
  "description": "Foundation catalog for bbangto-ui — amber + 74 brand presets (base light/dark/high-contrast live in core)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meta": {
      "types": "./dist/meta/index.d.ts",
      "import": "./dist/meta/index.js"
    },
    "./catalog": "./src/catalog.json",
    "./foundation.manifest.json": "./foundation.manifest.json"
  },
  "files": [
    "dist",
    "src/catalog.json",
    "foundation.manifest.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "gen:foundation-manifest": "tsx scripts/genFoundationManifest.ts",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@centurio1987/bbangto-ui-tokens": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.9"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/centurio1987/bbangto-ui.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
