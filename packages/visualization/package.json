{
  "name": "@centurio1987/bbangto-ui-visualization",
  "version": "2.0.0",
  "description": "Headless Visualization Design System (diagram / infographic) for bbangto-ui",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bbangto-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./type-meta": {
      "bbangto-source": "./src/typeMeta/index.ts",
      "types": "./dist/typeMeta/index.d.ts",
      "import": "./dist/typeMeta/index.js"
    },
    "./type.manifest.json": "./type.manifest.json",
    "./manifest/*": "./manifest/*"
  },
  "files": [
    "dist",
    "type.manifest.json",
    "manifest",
    "README.md"
  ],
  "scripts": {
    "prebuild": "pnpm gen:type-manifest",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "gen:type-manifest": "tsx --conditions=bbangto-source scripts/genTypeManifest.ts",
    "gen:type-jsdoc": "tsx --conditions=bbangto-source scripts/genTypeJsdoc.ts",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@centurio1987/bbangto-ui-tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "tsup": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.9"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/centurio1987/bbangto-ui.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
